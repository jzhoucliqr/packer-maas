echo "Installing custom packages for Fedora CoreOS"

# CoreOS uses rpm-ostree for package management
# This is different from traditional package managers like dnf/yum
# Packages are layered on top of the base ostree image

# Install essential packages that might be needed by MAAS
# Note: CoreOS comes with most necessary tools pre-installed

if [ -f /curtin/custom-packages.tar.gz ]; then
    echo "Found custom packages archive"
    cd /tmp
    tar -xzf /curtin/custom-packages.tar.gz
    
    # CoreOS package installation would typically use rpm-ostree
    # but since we're in a deployment context, we can use rpm directly
    # for adding packages to the live system
    
    if [ -d custom-packages ]; then
        cd custom-packages
        for pkg in *.rpm; do
            if [ -f "$pkg" ]; then
                echo "Installing $pkg"
                rpm -ivh "$pkg" || echo "Warning: Failed to install $pkg"
            fi
        done
    fi
    
    cd /
    rm -rf /tmp/custom-packages
else
    echo "No custom packages found to install"
fi

# Ensure MAAS agent dependencies are available
# Most should already be present in CoreOS
packages_to_check=(
    "cloud-init"
    "openssh-server"
    "curl"
    "wget"
)

for pkg in "${packages_to_check[@]}"; do
    if ! rpm -q "$pkg" >/dev/null 2>&1; then
        echo "Warning: $pkg not found - MAAS functionality may be limited"
    else
        echo "Verified: $pkg is installed"
    fi
done

echo "Custom package installation complete" 